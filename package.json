{
  "name": "sommarbingo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Föreningens Sommarbingo – en digital sommarutmaning för fotbollsföreningar (Skultuna IS)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:single": "tsc -p tsconfig.app.json --noEmit && vite build --mode singlefile",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.2"
  }
}
